{
  "name": "cronograma-de-estudos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Assistente local de preparação para concursos públicos",
  "author": "Cronograma de Estudos",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist-server/server/index.js",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "postinstall": "node scripts/copy-ocr.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests e2e electron scripts *.json *.ts",
    "format:check": "prettier --check src server shared tests e2e electron scripts *.json *.ts",
    "test:desktop": "node scripts/test-desktop.mjs",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@tesseract.js-data/por": "^1.0.0",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "sql.js": "^1.13.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "br.com.cronograma.estudos",
    "productName": "Cronograma de Estudos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-server/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    },
    "mac": {
      "category": "public.app-category.education"
    },
    "icon": "build/icon.png"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "UNLICENSED"
}
